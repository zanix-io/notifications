# Copy this file to `.env.test` (gitignored — never commit real credentials) and fill in real
# values to run the functional tests in `src/@tests/functional/` against real SMTP/Twilio/Meta
# accounts. Any test whose required variables are missing is skipped with a warning, not failed.

# --- emails.test.ts (SMTP) ---
SMTP_PORT=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
TEST_EMAIL_FROM=
TEST_EMAIL_TO=

# --- database-templates.test.ts (real local MongoDB) ---
MONGO_TEST_URI=

# --- sms.test.ts (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TEST_SMS_TO=
TWILIO_API_BASE=

# --- whatsapp.test.ts (WhatsApp Cloud API / Meta) ---
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_API_VERSION=
TEST_WHATSAPP_TO=
META_API_BASE=

# --- whatsapp.test.ts (Twilio WhatsApp API) ---
# Optional alternative to the Meta WhatsApp test. Use this only if you want to
# test the Twilio WhatsApp integration instead.
#
# Reuses TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN from the SMS configuration.
# Configure the following WhatsApp-specific environment variables:
#   - TWILIO_WHATSAPP_FROM
#   - TWILIO_WHATSAPP_TO
#
# These are typically different from the SMS phone numbers because they must be
# WhatsApp-enabled sender and recipient numbers.
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
